{
  "id": "cthulhu-dark-2e",
  "name": "Cthulhu Dark 2E",
  "version": "0.2",
  "summary": "以调查、压力、洞察和不可逆代价为核心的叙事恐怖规则档案。",
  "card_definitions": [
    {
      "type": "location",
      "display_name": "地点卡",
      "description": "整理可访问、可折返地点的常态、抵达描述、人物、线索、触发内容与回访变化。",
      "required_fields": ["normal_state", "arrival_description"],
      "optional_fields": ["direct_clues", "relevant_characters", "hidden_clues", "gm_moves", "return_changes", "first_triggers", "consequences", "display_materials", "exit_conditions"]
    },
    {
      "type": "chapter_overview",
      "display_name": "章节总览卡",
      "description": "承载跨地点背景、真相、阴谋、结局与全章后果。",
      "required_fields": ["situation", "truth", "major_threads", "endings"],
      "optional_fields": ["key_people", "cross_location_clues", "display_materials"]
    },
    {
      "type": "npc",
      "display_name": "功能 NPC 卡",
      "description": "记录人物在调查系统中的功能，而不是性格说明书。",
      "required_fields": ["role", "wants", "offers", "pressure_point", "refusal_consequence"],
      "optional_fields": ["first_impression", "secret", "voice_notes"]
    },
    {
      "type": "threat",
      "display_name": "威胁卡",
      "description": "描述威胁如何被感知、升级与绕过，不依赖数值挡板。",
      "required_fields": ["manifestation", "intention", "danger_signs", "escalation", "noncombat_exits"],
      "optional_fields": ["defensive_limits"]
    },
    {
      "type": "clock",
      "display_name": "推进钟",
      "description": "把时间、暴露和仪式后果变成可见的阶段。",
      "required_fields": ["name", "stages", "advance_condition"],
      "optional_fields": ["current_stage", "final_consequence"]
    }
  ],
  "risk_axes": ["exposure", "insight", "pursuit", "relationships"],
  "failure_moves": ["cost_forward", "reveal_pressure", "threat_advance"],
  "gm_moves": ["ask_a_question", "expose_a_cost", "advance_the_clock", "complicate_the_scene", "make_the_invisible_felt"],
  "prompts": {
    "scene_opening": "这里最先让人感到不对的是什么？谁仍假装一切正常？",
    "complication": "这次调查让谁注意到了他们，代价会先落在何处？",
    "failure": "失败不是挡板；它揭示压力、消耗关系，或让威胁前进一步。"
  },
  "scene_guidance": {
    "arrival": "把地点作为可回应的现场讲出来：给出可见的人、声音和异常，但不要列出调查动作。",
    "investigation": "让玩家的关注决定线索顺序；人物按自己的目的回应，失败或代价推进暴露、关系或洞察，不用阻塞式检定。",
    "pressure": "把时钟表现为现场变化与逼近，不提前宣布阶段；玩家拖延或付出代价时，再推进对应后果。",
    "confrontation": "先展示威胁意图和可怕前兆，给玩家改变位置、关系或证据的机会；不把威胁改写成数值面板。",
    "aftermath": "明确留下的证据、代价和新目标，把选择权交回玩家，而不是替他们决定下一站。"
  }
}
